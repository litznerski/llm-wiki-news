---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../config/site';
import { url } from '../utils/paths';
import { Home, Compass, Search, Terminal, Sparkles } from 'lucide-astro';
const notFound = siteConfig.notFound || {
  badge: 'HTTP_STATUS // 404_NOT_FOUND',
  title: 'Page Lost in the Stream',
  description:
    "The route, article, or resource you were looking for doesn't exist, has been moved, or is currently being rewritten.",
  homeButtonText: 'Return Home',
  browseButtonText: 'Browse Articles',
};
---

<BaseLayout
  title={`404: Page Not Found — ${siteConfig.name}`}
  description="The requested page or publication could not be found."
>
  <main class="flex-1 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 flex flex-col items-center justify-center text-center">
    <!-- Main Kepler 404 Hero Container -->
    <div class="w-full max-w-2xl kepler-card rounded-3xl p-8 sm:p-12 relative overflow-hidden shadow-2xl">
      <!-- Orbit Background Ring -->
      <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-72 h-72 border border-dashed border-orange-500/25 animate-[orbit-spin_30s_linear_infinite] pointer-events-none rounded-full" aria-hidden="true"></div>

      <!-- Top Pill Badge -->
      <div class="kepler-chip-orange mb-6">
        <Terminal class="w-3.5 h-3.5 text-orange-700" />
        <span>{notFound.badge}</span>
      </div>

      <!-- Giant 404 -->
      <div class="relative mb-4 select-none">
        <h1 class="text-8xl sm:text-9xl font-extrabold font-poppins tracking-tighter text-orange-400">
          404
        </h1>
      </div>

      <!-- Heading -->
      <h2 class="text-2xl sm:text-3xl font-extrabold font-poppins text-white tracking-tight mb-3">
        {notFound.title}
      </h2>

      <!-- Description -->
      <p class="text-sm sm:text-base text-zinc-200 max-w-md mx-auto leading-relaxed mb-8">
        {notFound.description}
      </p>

      <!-- Primary Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-3.5 mb-10">
        <a
          href={url('/')}
          class="kepler-btn-orange px-6 py-3 text-xs sm:text-sm cursor-pointer"
        >
          <Home class="w-4 h-4" />
          <span>{notFound.homeButtonText}</span>
        </a>

        <a
          href={url('/blog')}
          class="kepler-btn-navy px-6 py-3 text-xs sm:text-sm cursor-pointer"
        >
          <Compass class="w-4 h-4" />
          <span>{notFound.browseButtonText}</span>
        </a>

        <button
          id="trigger-search-404"
          type="button"
          class="kepler-btn-navy px-5 py-3 text-xs sm:text-sm cursor-pointer"
        >
          <Search class="w-4 h-4 text-orange-400" />
          <span>Search (⌘K)</span>
        </button>
      </div>

      <!-- Topic Shortcuts -->
      <div class="pt-6 border-t border-white/10">
        <div class="text-xs font-mono text-sky-200/80 mb-3 flex items-center justify-center gap-1.5">
          <Sparkles class="w-3.5 h-3.5 text-orange-400" />
          <span>// POPULAR EXPLORATION TOPICS</span>
        </div>
        <div class="flex flex-wrap justify-center gap-2">
          {siteConfig.categories.map((cat) => (
            <a
              href={url(`/categories/${cat.name.toLowerCase()}`)}
              class="px-3 py-1 rounded-full text-xs font-medium liquid-pill text-zinc-200 hover:text-orange-400 hover:border-orange-400/40 transition-all"
            >
              #{cat.name}
            </a>
          ))}
        </div>
      </div>
    </div>
  </main>

  <script>
    document.getElementById('trigger-search-404')?.addEventListener('click', () => {
      const openBtn = document.getElementById('search-open-btn');
      openBtn?.click();
    });
  </script>
</BaseLayout>
