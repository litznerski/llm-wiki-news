---
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteConfig from '../../config/site';
import { url } from '../../utils/paths';
import { getCollection } from 'astro:content';
import { isNotePublished } from '../../config/wiki.config';
import { Tag } from 'lucide-astro';

const allPosts = await getCollection('blog');
const allNotes = await getCollection('wiki');
const publishedNotes = allNotes.filter((note) => isNotePublished(note.id, note.data));

const tagMap = new Map<string, { name: string; count: number }>();

for (const post of allPosts) {
  const postTags = Array.isArray(post.data.tags) ? post.data.tags : [];
  for (const tag of postTags) {
    if (!tag || typeof tag !== 'string') continue;
    const key = tag.trim().toLowerCase();
    if (!tagMap.has(key)) {
      tagMap.set(key, { name: tag.trim(), count: 0 });
    }
    tagMap.get(key)!.count += 1;
  }
}

for (const note of publishedNotes) {
  const noteTags = Array.isArray(note.data?.tags) ? note.data.tags : [];
  for (const tag of noteTags) {
    if (!tag || typeof tag !== 'string') continue;
    const key = tag.trim().toLowerCase();
    if (!tagMap.has(key)) {
      tagMap.set(key, { name: tag.trim(), count: 0 });
    }
    tagMap.get(key)!.count += 1;
  }
}

const tagsWithCount = Array.from(tagMap.values()).sort((a, b) => b.count - a.count);
---

<BaseLayout
  title={`Tags Directory — ${siteConfig.name}`}
  description="Search and explore technical notes and publications by technology tags."
>
  <div class="mb-10 p-7 sm:p-10 kepler-card rounded-3xl shadow-xl">
    <div class="kepler-chip-orange mb-2.5">
      <Tag class="w-3.5 h-3.5 text-orange-700" />
      Topic Tags
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold font-poppins text-white tracking-tight">
      Explore by Tag
    </h1>
    <p class="text-sm text-zinc-200 mt-2 font-mono">
      // Filter through {tagsWithCount.length} topic tags across technical essays and knowledge wiki primitives.
    </p>
  </div>

  <div class="p-7 sm:p-10 kepler-card rounded-3xl shadow-xl">
    <div class="flex flex-wrap gap-3">
      {tagsWithCount.map((tag) => (
        <a
          href={url(`/tags/${encodeURIComponent(tag.name.toLowerCase())}`)}
          class="flex items-center gap-2 px-4 py-2 rounded-full bg-[#0a1628]/60 border border-white/10 hover:border-orange-400 hover:shadow-[1.5px_1.5px_0_var(--color-ink)] hover:scale-[1.02] transition-all text-xs sm:text-sm font-medium"
        >
          <span class="text-orange-400 font-mono text-xs font-semibold">#</span>
          <span class="text-zinc-100">{tag.name}</span>
          <span class="ml-1 px-2 py-0.5 text-[11px] bg-orange-500/20 text-orange-300 font-mono rounded-full border border-orange-400/25">
            {tag.count}
          </span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
