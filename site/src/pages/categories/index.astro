---
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteConfig from '../../config/site';
import { url } from '../../utils/paths';
import { getCollection } from 'astro:content';
import { isNotePublished, getWikiCategory, slugifyWikiTitle } from '../../config/wiki.config';
import { ArrowRight, Layers, BookOpen, Network } from 'lucide-astro';

const allPosts = await getCollection('blog');
const allNotes = await getCollection('wiki');
const publishedNotes = allNotes.filter((n) => isNotePublished(n.id, n.data));

const categories = siteConfig.categories;

const categoryList = categories.map((cat) => {
  const catSlug = slugifyWikiTitle(cat.name);
  const posts = allPosts.filter(
    (p) => slugifyWikiTitle(p.data.category) === catSlug || p.data.category.toLowerCase() === cat.name.toLowerCase()
  );
  const wikiNotes = publishedNotes.filter((n) => {
    const noteCat = getWikiCategory(n.data);
    return slugifyWikiTitle(noteCat) === catSlug || noteCat.toLowerCase() === cat.name.toLowerCase();
  });

  return {
    ...cat,
    slug: catSlug,
    posts,
    wikiNotes,
    totalCount: posts.length + wikiNotes.length,
  };
});
---

<BaseLayout
  title={`Explore Categories — ${siteConfig.name}`}
  description="Browse technical articles and architecture patterns organized by topic."
>
  <div class="mb-10 p-7 sm:p-10 kepler-card rounded-3xl shadow-xl">
    <div class="kepler-chip-orange mb-2.5">
      <Layers class="w-3.5 h-3.5 text-orange-700" />
      Topic Domains
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold font-poppins text-white tracking-tight">
      Browse by Category
    </h1>
    <p class="text-sm text-zinc-200 mt-2 font-mono">
      // Select a domain to explore specialized engineering guides, cognitive models, and knowledge wiki primitives.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {categoryList.map((cat) => (
      <a
        href={url(`/categories/${cat.slug}`)}
        class="group p-7 rounded-3xl kepler-card shadow-lg flex flex-col justify-between hover:border-orange-500/50 transition-all hover:-translate-y-1"
      >
        <div>
          <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-4">
            <h2 class="text-xl font-bold font-poppins text-white group-hover:text-orange-400 transition-colors">
              {cat.name}
            </h2>
            <div class="flex items-center gap-1.5 font-mono text-xs">
              <span class="px-2.5 py-1 rounded-full bg-orange-500/20 text-orange-300 border border-orange-400/30 flex items-center gap-1">
                <BookOpen class="w-3 h-3 text-orange-400" />
                <span>{cat.posts.length}</span>
              </span>
              <span class="px-2.5 py-1 rounded-full bg-sky-500/20 text-sky-300 border border-sky-400/30 flex items-center gap-1">
                <Network class="w-3 h-3 text-sky-400" />
                <span>{cat.wikiNotes.length}</span>
              </span>
            </div>
          </div>

          <p class="text-sm text-zinc-200 mb-6 leading-relaxed">
            {cat.desc}
          </p>
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-white/10 text-xs font-semibold text-orange-400 font-mono">
          <span>Explore {cat.totalCount} Resources ({cat.posts.length} Articles · {cat.wikiNotes.length} Wiki)</span>
          <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
        </div>
      </a>
    ))}
  </div>
</BaseLayout>
