---
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteConfig from '../../config/site';
import { url } from '../../utils/paths';
import { getCollection } from 'astro:content';
import { isNotePublished } from '../../config/wiki.config';
import WikiCard from '../../components/ui/WikiCard.astro';
import { 
  Network, 
  MessageSquare,
  Search
} from 'lucide-astro';

const allNotes = await getCollection('wiki');
const publishedNotes = allNotes.filter((note) => isNotePublished(note.id, note.data));

// Sort alphabetically by canonical title
publishedNotes.sort((a, b) => {
  const titleA = a.data?.title || a.id.replace(/\.md$/, '').split('/').pop() || '';
  const titleB = b.data?.title || b.id.replace(/\.md$/, '').split('/').pop() || '';
  return titleA.localeCompare(titleB);
});

const eventsCount = publishedNotes.filter((n) => n.data?.type === 'event').length;
const actorsCount = publishedNotes.filter((n) => n.data?.type === 'actor').length;
const locationsCount = publishedNotes.filter((n) => n.data?.type === 'location').length;
const themesCount = publishedNotes.filter((n) => n.data?.type === 'theme').length;
const timelinesCount = publishedNotes.filter((n) => n.data?.type === 'timeline').length;
const sourcesCount = publishedNotes.filter((n) => n.data?.type === 'source').length;
const synthesesCount = publishedNotes.filter((n) => n.data?.type === 'synthesis').length;
---

<BaseLayout
  title={`Sudan OSINT Intelligence Graph — ${siteConfig.name}`}
  description="5W1H conflict events, acting entities, UN OCHA P-Code locations, war economy themes, and NATO Admiralty-graded sources."
>
  <!-- Page Header -->
  <div class="mb-10 p-7 sm:p-10 kepler-card rounded-3xl shadow-xl relative overflow-hidden">
    <div class="flex flex-wrap items-center justify-between gap-6">
      <div class="max-w-2xl">
        <div class="kepler-chip-orange mb-3">
          <Network class="w-3.5 h-3.5 text-orange-700" />
          <span>Compiled 5W1H & GRaSP Intelligence Graph</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold font-poppins text-white tracking-tight leading-tight">
          Sudan News & OSINT Graph
        </h1>
        <p class="text-sm sm:text-base text-zinc-200 mt-3 font-normal leading-relaxed">
          Multilingual 5W1H conflict events, acting entities, UN OCHA P-Code locations, structural conflict drivers, and side-by-side GRaSP contradiction matrices.
        </p>

        <!-- Metric Badges -->
        <div class="flex flex-wrap items-center gap-3 mt-5 font-mono text-xs">
          <span class="px-3 py-1.5 rounded-full bg-white/10 border border-white/15 text-white">
            <strong class="text-orange-400 font-bold">{publishedNotes.length}</strong> Published Nodes
          </span>
          <span class="px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-zinc-300">
            <strong class="text-rose-300 font-bold">{eventsCount}</strong> Events
          </span>
          <span class="px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-zinc-300">
            <strong class="text-indigo-300 font-bold">{actorsCount}</strong> Actors
          </span>
          <span class="px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-zinc-300">
            <strong class="text-cyan-300 font-bold">{locationsCount}</strong> Locations
          </span>
          <span class="px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-zinc-300">
            <strong class="text-sky-300 font-bold">{themesCount}</strong> Themes
          </span>
          {timelinesCount > 0 && (
            <span class="px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-zinc-300">
              <strong class="text-purple-300 font-bold">{timelinesCount}</strong> Timelines
            </span>
          )}
          {sourcesCount > 0 && (
            <span class="px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-zinc-300">
              <strong class="text-amber-300 font-bold">{sourcesCount}</strong> Sources
            </span>
          )}
          {synthesesCount > 0 && (
            <span class="px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-zinc-300">
              <strong class="text-emerald-300 font-bold">{synthesesCount}</strong> Syntheses
            </span>
          )}
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="flex flex-col gap-3">
        <a
          href={url('/assistant')}
          class="px-5 py-3 rounded-full kepler-btn-orange text-xs font-bold uppercase tracking-wider text-white shadow-lg hover:scale-105 transition-all flex items-center justify-center gap-2"
        >
          <MessageSquare class="w-4 h-4" />
          <span>Open OSINT Studio</span>
        </a>
      </div>
    </div>

    <!-- Live Client-Side Filter Input -->
    <div class="mt-8 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="relative w-full sm:max-w-md">
        <Search class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-zinc-400" />
        <input
          id="wiki-filter-input"
          type="text"
          placeholder="Filter by title, P-Code (SD01-SD18), Arabic alias, or tag..."
          class="w-full pl-10 pr-4 py-2 rounded-full bg-black/25 border border-white/20 text-white text-xs font-mono placeholder:text-zinc-400 focus:outline-none focus:border-orange-500 focus:ring-1 focus:ring-orange-500 transition-all"
        />
      </div>

      <!-- Category Filter Tabs -->
      <div class="flex flex-wrap items-center gap-2" id="wiki-type-filters">
        <button
          data-type="all"
          class="wiki-filter-btn px-3.5 py-1.5 text-xs font-semibold rounded-full kepler-btn-orange transition-all cursor-pointer"
        >
          All
        </button>
        <button
          data-type="event"
          class="wiki-filter-btn px-3.5 py-1.5 text-xs font-semibold rounded-full kepler-btn-navy text-zinc-300 transition-all cursor-pointer"
        >
          Events
        </button>
        <button
          data-type="actor"
          class="wiki-filter-btn px-3.5 py-1.5 text-xs font-semibold rounded-full kepler-btn-navy text-zinc-300 transition-all cursor-pointer"
        >
          Actors
        </button>
        <button
          data-type="location"
          class="wiki-filter-btn px-3.5 py-1.5 text-xs font-semibold rounded-full kepler-btn-navy text-zinc-300 transition-all cursor-pointer"
        >
          Locations
        </button>
        <button
          data-type="theme"
          class="wiki-filter-btn px-3.5 py-1.5 text-xs font-semibold rounded-full kepler-btn-navy text-zinc-300 transition-all cursor-pointer"
        >
          Themes
        </button>
        {sourcesCount > 0 && (
          <button
            data-type="source"
            class="wiki-filter-btn px-3.5 py-1.5 text-xs font-semibold rounded-full kepler-btn-navy text-zinc-300 transition-all cursor-pointer"
          >
            Sources
          </button>
        )}
        {synthesesCount > 0 && (
          <button
            data-type="synthesis"
            class="wiki-filter-btn px-3.5 py-1.5 text-xs font-semibold rounded-full kepler-btn-navy text-zinc-300 transition-all cursor-pointer"
          >
            Syntheses
          </button>
        )}
      </div>
    </div>
  </div>

  <!-- Primitives Grid -->
  <div id="wiki-cards-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {publishedNotes.map((note) => (
      <WikiCard note={note} />
    ))}
  </div>

  <!-- Empty State Message -->
  <div id="wiki-empty-msg" class="hidden p-12 text-center white-card-3d text-zinc-900 rounded-3xl mt-6">
    <p class="text-sm font-mono text-zinc-500">No intelligence nodes match your active filter.</p>
  </div>
</BaseLayout>

<script>
  function setupWikiFilters() {
    const input = document.getElementById('wiki-filter-input') as HTMLInputElement | null;
    const filterButtons = document.querySelectorAll('.wiki-filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.wiki-card');
    const emptyMsg = document.getElementById('wiki-empty-msg');

    let activeType = 'all';

    function applyFilter() {
      const query = (input?.value || '').toLowerCase().trim();
      let visibleCount = 0;

      cards.forEach((card) => {
        const title = card.dataset.title || '';
        const cardType = card.dataset.type || '';
        const tags = card.dataset.tags || '';
        const aliases = card.dataset.aliases || '';

        const matchesType = activeType === 'all' || cardType === activeType;
        const matchesQuery = !query || 
          title.includes(query) || 
          tags.includes(query) || 
          aliases.includes(query);

        if (matchesType && matchesQuery) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (emptyMsg) {
        emptyMsg.classList.toggle('hidden', visibleCount > 0);
      }
    }

    if (input) {
      input.addEventListener('input', applyFilter);
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => {
          b.classList.remove('kepler-btn-orange');
          b.classList.add('kepler-btn-navy', 'text-zinc-300');
        });

        btn.classList.add('kepler-btn-orange');
        btn.classList.remove('kepler-btn-navy', 'text-zinc-300');

        activeType = (btn as HTMLElement).dataset.type || 'all';
        applyFilter();
      });
    });
  }

  setupWikiFilters();
  document.addEventListener('astro:after-swap', setupWikiFilters);
</script>
