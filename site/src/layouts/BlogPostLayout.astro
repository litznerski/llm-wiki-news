---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/ui/TableOfContents.astro';
import TagBadge from '../components/ui/TagBadge.astro';
import siteConfig from '../config/site';
import { url } from '../utils/paths';
import { Calendar, Clock, Share2, ArrowLeft, ArrowRight, Twitter, Linkedin, Mail } from 'lucide-astro';

interface Props {
  post: any;
  headings: any[];
  readingTime?: string;
  prevPost?: any;
  nextPost?: any;
}

const { post, headings = [], readingTime, prevPost, nextPost } = Astro.props;
const data = post.data;

// Single author from centralized site config
const authorName = siteConfig.author.name;
const authorRole = siteConfig.author.role;
const authorAvatar = siteConfig.author.avatar;
const authorBio = siteConfig.author.bio;
const authorSocial = siteConfig.author.social;
const ui = siteConfig.ui || {
  shareTitle: 'Share This Post',
  shareDescription: 'Found this post helpful? Share it with your developer friends.',
  shareCopiedMessage: 'Post link copied to clipboard!',
  authorCardTitle: 'About the Author',
  writtenByText: 'Written by',
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={data.heroImage}
  article={true}
>
  <!-- Reading Progress Bar -->
  <div
    id="reading-progress-bar"
    class="fixed top-0 left-0 h-1 bg-gradient-to-r from-orange-400 via-orange-500 to-amber-300 z-50 transition-all duration-75 shadow-xs shadow-orange-500/50"
    style="width: 0%;"
  ></div>

  <!-- Breadcrumb / Back Link -->
  <nav class="mb-6 flex items-center justify-between">
    <a
      href={url('/blog')}
      class="inline-flex items-center gap-2 text-xs font-semibold font-mono uppercase tracking-wider text-zinc-300 hover:text-orange-400 transition-colors"
    >
      <ArrowLeft class="w-3.5 h-3.5 text-orange-400" />
      <span>All Articles</span>
    </a>

    <div class="flex items-center gap-2">
      <span class="kepler-chip-orange">
        {data.category}
      </span>
    </div>
  </nav>

  <!-- Article Header Banner -->
  <header class="p-6 sm:p-10 lg:p-12 kepler-card rounded-3xl shadow-xl mb-8 relative overflow-hidden">
    <!-- Optional Hero Image on Top of Blog Post -->
    {data.heroImage && (
      <div class="mb-8 -mx-2 sm:-mx-4 -mt-2 sm:-mt-4 rounded-2xl overflow-hidden border border-zinc-700 relative group">
        <img
          src={url(data.heroImage)}
          alt={data.heroImageAlt || data.title}
          class="w-full h-60 sm:h-80 md:h-[380px] object-cover object-center transition-transform duration-700 ease-out group-hover:scale-[1.02]"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#0a1628]/50 via-[#0a1628]/10 to-transparent pointer-events-none"></div>
      </div>
    )}

    <!-- Top Tags & Meta -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
      <div class="flex items-center gap-2">
        <span class="kepler-chip-orange">
          {data.category}
        </span>
      </div>

      <div class="flex items-center gap-4 text-xs font-mono text-sky-200/80">
        <span class="flex items-center gap-1.5">
          <Calendar class="w-3.5 h-3.5 text-orange-400" />
          {new Date(data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
        </span>
        {readingTime && (
          <span class="flex items-center gap-1.5 text-orange-400 font-medium">
            <Clock class="w-3.5 h-3.5" />
            {readingTime}
          </span>
        )}
      </div>
    </div>

    <!-- Main Title -->
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-poppins text-white tracking-tight leading-tight mb-5">
      {data.title}
    </h1>

    <!-- Description / Hook -->
    <p class="text-base sm:text-lg text-zinc-200 font-normal leading-relaxed max-w-3xl mb-8">
      {data.description}
    </p>

    <!-- Meta bottom row -->
    <div class="pt-6 border-t border-white/10 flex flex-wrap items-center justify-between gap-4">
      <!-- Author info with photo -->
      <div class="flex items-center gap-3">
        {authorAvatar && (authorAvatar.startsWith('/') || authorAvatar.startsWith('http')) ? (
          <img
            src={url(authorAvatar)}
            alt={authorName}
            class="w-11 h-11 rounded-full object-cover border border-white/15 shadow-md ring-2 ring-orange-500/20"
          />
        ) : (
          <div class="w-11 h-11 rounded-full liquid-pill flex items-center justify-center font-bold text-sm text-orange-400 shadow-xs">
            {authorAvatar || '⚡'}
          </div>
        )}
        <div>
          <div class="font-bold font-poppins text-sm text-white">{authorName}</div>
          <div class="text-[11px] font-mono text-zinc-400">{authorRole}</div>
        </div>
      </div>

      <!-- Tag list -->
      <div class="flex flex-wrap gap-1.5">
        {data.tags?.map((tag: string) => (
          <TagBadge tag={tag} size="sm" />
        ))}
      </div>
    </div>
  </header>

  <!-- Main Content Layout Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Left: Navigation Sidebar (4 cols) -->
    <aside class="lg:col-span-4 space-y-6 lg:sticky lg:top-24 lg:self-start lg:max-h-[calc(100vh-7rem)] lg:overflow-y-auto pr-1">
      <!-- Table of Contents -->
      <TableOfContents headings={headings} />

      <!-- Share Widget -->
      <div class="white-card-3d text-zinc-900 rounded-3xl p-6 overflow-hidden">
        <div class="text-xs uppercase tracking-wider font-bold text-[#0a1628] mb-1.5 font-poppins">
          {ui.shareTitle || 'Share This Post'}
        </div>
        <p class="text-xs text-zinc-600 mb-4 leading-relaxed">
          {ui.shareDescription || 'Found this post helpful? Share it with your developer friends.'}
        </p>
        <button
          onclick={`navigator.clipboard.writeText(window.location.href); alert(${JSON.stringify(ui.shareCopiedMessage || 'Post link copied to clipboard!')});`}
          class="w-full py-2.5 rounded-full kepler-btn-orange text-xs font-semibold cursor-pointer flex items-center justify-center gap-2 transition-all"
        >
          <Share2 class="w-3.5 h-3.5" />
          <span>Copy Post Link</span>
        </button>
      </div>
    </aside>

    <!-- Right: Article Body with Clean Dark Grey Border (8 cols) -->
    <article data-pagefind-body class="lg:col-span-8 white-card-3d text-zinc-900 p-6 sm:p-10 lg:p-12 rounded-3xl overflow-hidden">
      <div class="prose prose-zinc max-w-none 
        prose-headings:font-bold prose-headings:tracking-tight prose-headings:font-poppins prose-headings:text-[#0a1628]
        prose-h2:border-b prose-h2:border-zinc-200 prose-h2:pb-3 prose-h2:mt-10 prose-h2:mb-4 prose-h2:text-[#0a1628]
        prose-h3:text-[#ea580c] prose-h3:mt-8 prose-h3:mb-3
        prose-p:leading-relaxed prose-p:text-[#334155]
        prose-a:text-[#ea580c] prose-a:font-semibold prose-a:underline underline-offset-4 hover:prose-a:text-[#c2410c]
        prose-strong:font-bold prose-strong:text-[#0a1628]
        prose-code:font-mono prose-code:text-[#9a3412] prose-code:bg-orange-50 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-code:border prose-code:border-orange-200
        prose-blockquote:border-l-4 prose-blockquote:border-orange-500 prose-blockquote:bg-orange-50/70 prose-blockquote:text-[#334155] prose-blockquote:py-3 prose-blockquote:px-5 prose-blockquote:rounded-r-2xl prose-blockquote:italic
        prose-th:text-[#0a1628] prose-th:border-zinc-300 prose-td:text-[#334155] prose-td:border-zinc-200
      ">
        <slot />
      </div>

      <!-- Chapter Navigation Links -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-8 pt-8 border-t border-zinc-200">
        {prevPost ? (
          <a
            href={url(`/blog/${prevPost.id.replace(/\.(md|mdx)$/, '')}`)}
            class="p-4 rounded-2xl bg-[#f8fafc] border-2 border-zinc-300 hover:border-orange-500 hover:-translate-y-0.5 flex flex-col justify-between transition-all"
          >
            <span class="text-xs text-orange-600 font-bold font-mono flex items-center gap-1 uppercase">
              <ArrowLeft class="w-3.5 h-3.5" /> Previous Article
            </span>
            <span class="text-sm font-bold font-poppins text-[#0a1628] line-clamp-1 mt-1">
              {prevPost.data.title}
            </span>
          </a>
        ) : (
          <div class="p-4 rounded-2xl border border-dashed border-zinc-300 text-zinc-400 font-mono text-xs flex items-center">
            // Earliest Post
          </div>
        )}

        {nextPost ? (
          <a
            href={url(`/blog/${nextPost.id.replace(/\.(md|mdx)$/, '')}`)}
            class="p-4 rounded-2xl bg-[#f8fafc] border-2 border-zinc-300 hover:border-orange-500 hover:-translate-y-0.5 flex flex-col justify-between text-right transition-all"
          >
            <span class="text-xs text-orange-600 font-bold font-mono flex items-center justify-end gap-1 uppercase">
              Next Post <ArrowRight class="w-3.5 h-3.5" />
            </span>
            <span class="text-sm font-bold font-poppins text-[#0a1628] line-clamp-1 mt-1">
              {nextPost.data.title}
            </span>
          </a>
        ) : (
          <div class="p-4 rounded-2xl border border-dashed border-zinc-300 text-zinc-400 font-mono text-xs flex items-center justify-end">
            // Latest Post
          </div>
        )}
      </div>
    </article>
  </div>
</BaseLayout>

<script>
  function setupReadingProgress() {
    const bar = document.getElementById('reading-progress-bar');
    if (!bar) return;

    window.addEventListener('scroll', () => {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const progress = scrollHeight > 0 ? (scrollTop / scrollHeight) * 100 : 0;
      bar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
    });
  }

  setupReadingProgress();
  document.addEventListener('astro:after-swap', setupReadingProgress);
</script>
