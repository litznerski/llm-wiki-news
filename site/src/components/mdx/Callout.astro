---
interface Props {
  type?: 'tip' | 'warning' | 'secret' | 'technique';
  title?: string;
  badge?: string;
}

const {
  type = 'tip',
  title,
  badge,
} = Astro.props;

const styles = {
  tip: {
    border: 'border-l-4 border-l-orange-500',
    badgeBg: 'bg-orange-100 text-orange-800 border-orange-200',
    defaultBadge: 'PRO TIP',
    icon: '💡',
  },
  warning: {
    border: 'border-l-4 border-l-rose-500',
    badgeBg: 'bg-rose-100 text-rose-800 border-rose-200',
    defaultBadge: 'WARNING',
    icon: '⚠️',
  },
  secret: {
    border: 'border-l-4 border-l-navy',
    badgeBg: 'bg-sky-100 text-navy border-sky-200',
    defaultBadge: 'ARCHITECTURE NOTE',
    icon: '📜',
  },
  technique: {
    border: 'border-l-4 border-l-orange-600',
    badgeBg: 'bg-orange-100 text-orange-900 border-orange-300',
    defaultBadge: 'CORE TECHNIQUE',
    icon: '⚡',
  },
};

const current = styles[type];
---

<div
  class:list={[
    'my-6 p-5 sm:p-6 rounded-3xl bg-[#f8fafc] border border-zinc-200 shadow-[3px_3px_0_var(--color-ink)] transition-all overflow-hidden',
    current.border,
  ]}
>
  <div class="flex items-center gap-3 mb-3">
    <span class="text-lg select-none">{current.icon}</span>
    <span
      class:list={[
        'text-xs font-bold font-mono px-2.5 py-0.5 rounded-full border shadow-2xs tracking-wider uppercase',
        current.badgeBg,
      ]}
    >
      {badge || current.defaultBadge}
    </span>
    {title && (
      <span class="text-sm sm:text-base font-bold font-poppins text-[#0a1628]">
        {title}
      </span>
    )}
  </div>
  <div class="prose prose-sm max-w-none text-zinc-800 leading-relaxed">
    <slot />
  </div>
</div>
