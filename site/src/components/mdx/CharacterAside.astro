---
import { url } from '../../utils/paths';

interface Props {
  name: string;
  role?: string;
  avatar?: string;
}

const {
  name = 'Architecture Note',
  role = 'Lead Engineer',
  avatar = '⚡',
} = Astro.props;
---

<aside class="my-6 p-6 rounded-3xl bg-[#f8fafc] border border-zinc-200 shadow-[3px_3px_0_var(--color-ink)] flex flex-col sm:flex-row items-start gap-4 overflow-hidden">
  <div class="flex sm:flex-col items-center gap-2.5 sm:gap-2 shrink-0">
    <div class="w-12 h-12 rounded-full bg-orange-50 border-2 border-orange-300 flex items-center justify-center text-2xl shadow-xs">
      {avatar.startsWith('http') || avatar.startsWith('/') ? (
        <img src={url(avatar)} alt={name} class="w-full h-full object-cover rounded-full" />
      ) : (
        <span>{avatar}</span>
      )}
    </div>
    <div class="text-left sm:text-center">
      <div class="font-bold font-poppins text-xs text-[#0a1628]">{name}</div>
      <div class="text-[10px] font-mono uppercase text-orange-700 font-semibold">{role}</div>
    </div>
  </div>

  <div class="flex-1 text-sm text-zinc-800 relative">
    <div class="prose prose-sm max-w-none leading-relaxed">
      <slot />
    </div>
  </div>
</aside>
