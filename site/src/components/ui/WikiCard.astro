---
import TagBadge from './TagBadge.astro';
import { url } from '../../utils/paths';
import { slugifyWikiTitle, getWikiCategory, getWikiCategorySlug } from '../../config/wiki.config';
import { ShieldCheck, ArrowRight, MessageSquare, Layers } from 'lucide-astro';

interface Props {
  note: any;
  showCategory?: boolean;
}

const { note, showCategory = true } = Astro.props;
const data = note.data || {};
const title = data.title || note.id.replace(/\.md$/, '').split('/').pop() || '';
const slug = slugifyWikiTitle(title);
const type = data.type || 'event';
const subtype = data.subtype;
const pcode = data.pcode;
const admiralty = data.admiralty_rating;
const tags = Array.isArray(data.tags) ? data.tags : [];
const aliases = Array.isArray(data.aliases) ? data.aliases : [];
const reliability = typeof data.reliability_score === 'number' ? data.reliability_score : 1.0;
const category = getWikiCategory(data);
const categorySlug = getWikiCategorySlug(category);
const sparUrl = url(`/assistant?q=${encodeURIComponent(`Analyze [[${title}]]`)}`);

const typeColorClass =
  type === 'event'
    ? 'bg-rose-100 text-rose-900 border-rose-300'
    : type === 'actor'
    ? 'bg-indigo-100 text-indigo-900 border-indigo-300'
    : type === 'location'
    ? 'bg-cyan-100 text-cyan-900 border-cyan-300'
    : type === 'source'
    ? 'bg-amber-100 text-amber-900 border-amber-300'
    : type === 'synthesis'
    ? 'bg-emerald-100 text-emerald-900 border-emerald-300'
    : 'bg-orange-100 text-orange-900 border-orange-300';
---

<article
  data-title={title.toLowerCase()}
  data-type={type.toLowerCase()}
  data-category={category.toLowerCase()}
  data-tags={tags.join(' ').toLowerCase()}
  data-aliases={[...aliases, pcode || ''].join(' ').toLowerCase()}
  class="wiki-card bg-white text-slate-900 p-6 rounded-3xl border border-slate-300 shadow-sm flex flex-col justify-between transition-all duration-200 hover:-translate-y-1 hover:border-orange-500 hover:shadow-md group"
>
  <div>
    <!-- Top Meta Row -->
    <div class="flex items-center justify-between gap-2 mb-3.5">
      <div class="flex flex-wrap items-center gap-1.5">
        <span class={`px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase tracking-wider border ${typeColorClass}`}>
          {type}
        </span>
        {subtype && (
          <span class="px-2 py-0.5 rounded-full text-[10px] font-mono text-slate-800 bg-slate-100 border border-slate-300 font-semibold">
            {subtype}
          </span>
        )}
        {pcode && (
          <span class="px-2 py-0.5 rounded-full text-[10px] font-mono text-cyan-900 bg-cyan-50 border border-cyan-300 font-bold">
            {pcode}
          </span>
        )}
        {showCategory && (
          <a
            href={url(`/categories/${categorySlug}`)}
            class="px-2 py-0.5 rounded-full text-[10px] font-mono text-slate-800 bg-slate-100 hover:bg-orange-100 hover:text-orange-800 hover:border-orange-300 transition-colors border border-slate-300 flex items-center gap-1 font-semibold"
          >
            <Layers class="w-2.5 h-2.5 text-orange-600" />
            <span>{category}</span>
          </a>
        )}
      </div>

      <span class="inline-flex items-center gap-1 text-[10px] font-mono font-bold text-emerald-900 bg-emerald-100 px-2 py-0.5 rounded-md border border-emerald-300 shrink-0">
        <ShieldCheck class="w-3 h-3 text-emerald-700" />
        {admiralty ? `${admiralty} (${(reliability * 100).toFixed(0)}%)` : `${(reliability * 100).toFixed(0)}%`}
      </span>
    </div>

    <!-- Title -->
    <h2 class="text-lg font-bold font-poppins text-slate-900 group-hover:text-orange-600 transition-colors leading-snug mb-2">
      <a href={url(`/wiki/${slug}`)} class="focus:outline-none">
        {title}
      </a>
    </h2>

    <!-- Aliases (if available) -->
    {aliases.length > 0 && (
      <p class="text-xs font-mono text-slate-700 line-clamp-1 mb-3">
        <span class="text-slate-900 font-bold">aka:</span> {aliases.join(', ')}
      </p>
    )}

    <!-- Tags Rendering -->
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mb-4">
        {tags.slice(0, 3).map((tag: string) => (
          <TagBadge tag={tag} size="sm" variant="light" />
        ))}
        {tags.length > 3 && (
          <span class="text-[11px] font-mono font-bold text-slate-700 bg-slate-100 px-2 py-0.5 rounded-full border border-slate-300 self-center">
            +{tags.length - 3}
          </span>
        )}
      </div>
    )}
  </div>

  <!-- Bottom Card Footer with Actions -->
  <div class="pt-4 mt-4 border-t border-slate-200 flex items-center justify-between text-xs">
    <a
      href={url(`/wiki/${slug}`)}
      class="font-bold text-orange-700 hover:text-orange-800 flex items-center gap-1 group-hover:translate-x-0.5 transition-transform"
    >
      <span>Explore node</span>
      <ArrowRight class="w-3.5 h-3.5" />
    </a>

    <a
      href={sparUrl}
      title={`Analyze [[${title}]] in OSINT Studio`}
      class="p-1.5 rounded-full hover:bg-orange-100 text-slate-600 hover:text-orange-700 transition-colors cursor-pointer"
    >
      <MessageSquare class="w-3.5 h-3.5" />
    </a>
  </div>
</article>
