---
import siteConfig from '../../config/site';
import { url } from '../../utils/paths';
import { ArrowRight, Calendar, User, Sparkles } from 'lucide-astro';

interface Props {
  post: any;
}

const { post } = Astro.props;
const data = post.data;
const slug = post.id.replace(/\.(md|mdx)$/, '');
const authorName = siteConfig.author.name;
const authorAvatar = siteConfig.author.avatar;
const postUrl = url(`/blog/${slug}`);
---

<section class="relative my-4 sm:my-10">
  <div class="relative kepler-card rounded-3xl p-5 sm:p-8 lg:p-12 shadow-xl overflow-hidden group">
    
    <!-- Ambient Internal Orbit Arc -->
    <div class="absolute -right-20 -bottom-20 w-80 h-80 rounded-full border border-dashed border-orange-500/20 pointer-events-none animate-[orbit-spin_30s_linear_infinite]"></div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-center relative z-10">
      <div class={data.heroImage ? 'lg:col-span-7' : 'lg:col-span-12'}>
        <!-- Top Pill Meta -->
        <div class="flex flex-wrap items-center gap-2 sm:gap-3 mb-4 sm:mb-6">
          <span class="kepler-chip-orange">
            <Sparkles class="w-3.5 h-3.5 text-orange-700" />
            Featured Article
          </span>
          <span class="kepler-chip-navy">
            {data.category}
          </span>
          {data.issueNumber && (
            <span class="text-xs text-sky-200/80 font-mono">
              {data.issueNumber}
            </span>
          )}
        </div>

        <!-- Main Title Headline -->
        <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold font-poppins text-white tracking-tight leading-[1.2] sm:leading-[1.15] mb-3 sm:mb-5">
          <a href={postUrl} class="hover:text-orange-400 transition-colors">
            {data.title}
          </a>
        </h1>

        <!-- Description -->
        <p class="text-sm sm:text-lg text-zinc-200 font-normal leading-relaxed mb-6 sm:mb-8 max-w-2xl">
          {data.description}
        </p>

        <!-- Metadata Bar & Action -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 sm:gap-6 pt-5 sm:pt-6 border-t border-white/10">
          <div class="flex flex-wrap items-center gap-3 sm:gap-4 text-xs text-zinc-300">
            <div class="flex items-center gap-2 font-medium text-zinc-200">
              {authorAvatar && (authorAvatar.startsWith('/') || authorAvatar.startsWith('http')) ? (
                <img
                  src={url(authorAvatar)}
                  alt={authorName}
                  class="w-6 h-6 rounded-full object-cover border border-white/15 shrink-0"
                />
              ) : (
                <User class="w-3.5 h-3.5 text-orange-400" />
              )}
              <span>{authorName}</span>
            </div>
            <div class="flex items-center gap-1.5 font-mono text-sky-200/80">
              <Calendar class="w-3.5 h-3.5" />
              <span>{new Date(data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
            </div>
          </div>

          <a
            href={postUrl}
            class="kepler-btn-orange px-6 py-3 text-sm w-full sm:w-auto"
          >
            <span>Read Article</span>
            <ArrowRight class="w-4 h-4" />
          </a>
        </div>
      </div>

      {data.heroImage && (
        <div class="lg:col-span-5 flex items-center justify-center self-center lg:-translate-y-6">
          <a
            href={postUrl}
            class="block w-full rounded-2xl overflow-hidden border border-white/15 shadow-[6px_6px_0_var(--color-ink)] group/img relative"
          >
            <img
              src={url(data.heroImage)}
              alt={data.heroImageAlt || data.title}
              class="w-full h-64 sm:h-76 lg:h-[310px] object-cover object-center transition-transform duration-700 ease-out group-hover/img:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0a1628]/40 via-transparent to-transparent pointer-events-none"></div>
          </a>
        </div>
      )}
    </div>
  </div>
</section>
